{
  "name": "fe-interview-design-system",
  "private": true,
  "version": "0.1.0",
  "description": "Accessible Tabs design-system components (Badge, Tab, Tabs, TabPanel).",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context/sizeContext": {
      "types": "./dist/lib/context/sizeContext.d.ts",
      "import": "./dist/context/sizeContext.js"
    },
    "./context/activeTabContext": {
      "types": "./dist/lib/context/activeTabContext.d.ts",
      "import": "./dist/context/activeTabContext.js"
    },
    "./context/tabVariantContext": {
      "types": "./dist/lib/context/tabVariantContext.d.ts",
      "import": "./dist/context/tabVariantContext.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build --config vite.lib.config.ts",
    "build-storybook": "storybook build",
    "dev": "vite",
    "check": "biome check . --no-errors-on-unmatched",
    "check:fix": "biome check . --write",
    "generate": "plop",
    "generate:component": "plop component",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:smoke": "pnpm build && vitest run smoke",
    "tsc": "tsc -b"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "jsdom": "^30.1.1",
    "plop": "^4.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "^1.104.1",
    "storybook": "^10.6.1",
    "storybook-addon-pseudo-states": "10.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.0"
  }
}
